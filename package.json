{
  "name": "wg",
  "version": "0.1.0",
  "bin": {
    "wg": "./index.ts"
  },
  "type": "module",
  "scripts": {
    "wg": "bun run index.ts",
    "compile": "bun run build.ts",
    "install-bin": "bun run compile && mkdir -p ~/.local/bin && mv bin/wg ~/.local/bin/wg",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@morphllm/morphsdk": "^0.2.168",
    "@vscode/ripgrep-darwin-arm64": "^1.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  }
}
